# --- Base de datos local (SQLite; archivo en server/prisma) ---
DATABASE_URL="file:./sl-construcciones.db"

# --- Servidor ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REQUIRE_EMAIL_VERIFICATION=false

# --- Google OAuth (opcional) ---
GOOGLE_CLIENT_ID=

# --- Correo SMTP (opcional; sin esto los correos no se envían y se avisa en el log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="S&L Construcciones <adminsylconstrucciones@gmail.com>"
ADMIN_NOTIFY_EMAIL=

# --- Almacenamiento: local | s3 ---
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Solo para: npm run seed:admin ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Generate a unique password and JWT secret before using Docker Compose.
POSTGRES_DB=sl_construcciones
POSTGRES_USER=sl_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_URL_SAFE_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Optional: seed the first administrator when starting Docker Compose.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
